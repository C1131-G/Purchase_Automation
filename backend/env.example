NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# Main HANA Database
HANA_HOST=<host>
HANA_PORT=30015
HANA_USER=<username>
HANA_PASSWORD=<password>
HANA_POOLING=false
HANA_MAX_POOL_SIZE=50
HANA_CONNECTION_LIFE_TIME=3600
COMMON_DB=<db_name>
ORGANIZATION_TABLE=VST_COMMON

# SAP Service Layer Configuration
SERVICE_LAYER_URL=https://<host>:50000/b1s/v1
SERVICE_LAYER_HTTPS_VERIFY=false

# Session Configuration
SESSION_SECRET=<128_char_secure_secret>