{
  "name": "vendor-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:frontend": "pnpm --dir frontend dev",
    "dev:hana-backend": "pnpm --dir hana-backend dev",
    "build": "pnpm fix && pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm dlx ultracite check",
    "lint:fix": "pnpm dlx ultracite fix",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "fix": "pnpm dlx ultracite fix",
    "prepare": "pnpm exec lefthook install"
  },
  "devDependencies": {
    "eslint-plugin-github": "6.0.0",
    "lefthook": "^1.13.6",
    "lint-staged": "^15.5.2",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "oxlint-plugin-react-doctor": "^0.7.6",
    "ultracite": "7.9.4"
  },
  "packageManager": "pnpm@11.13.0"
}
