# Root-level markdown only (scratch notes, drafts).
/*.md
!/README.md
!/COMMIT_MESSAGE.md
!/AGENTS.md
!/PRODUCT.md

.env
.zed
.codex
.commandcode
.vscode
# Scratch notes folder at repo root only (do not ignore **/docs/)
/Docs/
.pnpm-store/
node_modules/
dist/
node_modules/
.vs/
agent-tools/
mcps/

# TypeScript incremental build cache (never commit)
*.tsbuildinfo

# Leftover from husky; project uses lefthook
.husky/

# Nested package lockfiles — monorepo uses root pnpm-lock.yaml only
frontend/pnpm-lock.yaml
hana-backend/pnpm-lock.yaml

# Local utility scripts (not versioned)
/scripts/
/frontend/scripts/
