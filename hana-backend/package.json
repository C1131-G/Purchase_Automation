{
  "name": "hana-backend",
  "version": "1.0.0",
  "description": "Hana Server backend for vendor portal",
  "license": "ISC",
  "author": "CIBI",
  "type": "module",
  "scripts": {
    "start": "node --import ./dist/core/observability/register.js dist/server.js",
    "dev": "tsx --watch --watch-path ./src --watch-preserve-output --import ./src/core/observability/register.ts src/server.ts",
    "worker:ic": "tsx --import ./src/core/observability/register.ts src/modules/intercompany/background/worker.entry.ts",
    "worker:ic:once": "tsx --import ./src/core/observability/register.ts src/modules/intercompany/background/worker.entry.ts --once",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && tsup",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:smoke": "vitest run tests/smoke",
    "test:coverage": "vitest run --coverage",
    "openapi:lint": "vitest run tests/smoke/openapi-contract.test.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.9.0",
    "@opentelemetry/exporter-prometheus": "^0.220.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/instrumentation-express": "^0.68.0",
    "@opentelemetry/instrumentation-http": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-metrics": "^2.9.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/sdk-trace-node": "^2.9.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sap/hana-client": "^2.27.19",
    "axios": "^1.13.2",
    "axios-retry": "^4.5.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.2",
    "formidable": "^3.5.4",
    "helmet": "^8.1.0",
    "lru-cache": "^11.2.5",
    "pdfkit": "^0.19.1",
    "pino": "^10.2.0",
    "reflect-metadata": "^0.2.2",
    "session-file-store": "^1.5.0",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.28",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.1",
    "@types/express-session": "^1.18.2",
    "@types/formidable": "^3.4.6",
    "@types/node": "^25.0.10",
    "@types/qs": "^6.14.0",
    "@types/serve-static": "^2.2.0",
    "@types/session-file-store": "^1.2.6",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsup": "^8.3.5",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^4.1.10"
  }
}
