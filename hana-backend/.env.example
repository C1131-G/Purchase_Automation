NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info

# Main HANA Database
HANA_HOST=<host>
HANA_PORT=30015
HANA_USER=<username>
HANA_PASSWORD=<password>
HANA_POOLING=false
HANA_MAX_POOL_SIZE=50
HANA_CONNECTION_LIFE_TIME=3600
COMMON_DB=<db_name>
ORGANIZATION_TABLE=VST_COMMON

# SAP Service Layer Configuration
SERVICE_LAYER_URL=https://<host>:50000/b1s/v1
SERVICE_LAYER_HTTPS_VERIFY=false

# Session + portal password (backend only — never put these in frontend/.env)
SESSION_SECRET=<128_char_secure_secret>
PORTAL_PASSWORD_SALT_ROUNDS=10

# Attachments Configuration
ATTACHMENTS_BASE_PATH=<path_to_attachments_base_folder>

# Fallback Currency Configuration
DEFAULT_CURRENCY_CODE=FJD